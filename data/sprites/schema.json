{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "version", "format", "assets", "clips"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "format": {"type": "string", "enum": ["sprite-pack-v1"]},
    "assets": {
      "type": "object",
      "required": ["image_format", "frame_width", "frame_height"],
      "properties": {
        "image_format": {"type": "string", "enum": ["png"]},
        "frame_width": {"type": "integer", "minimum": 1},
        "frame_height": {"type": "integer", "minimum": 1}
      }
    },
    "intent_map": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "clips": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^.+$": {"$ref": "#/definitions/clip"}
      }
    }
  },
  "definitions": {
    "clip": {
      "type": "object",
      "required": ["mode", "frames"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["loop", "once", "hold", "ping_pong", "timed"]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "duration_ms"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "duration_ms": {"type": "integer", "minimum": 1}
            }
          }
        },
        "interval_ms": {"type": "integer", "minimum": 1},
        "return_to": {"type": "string", "minLength": 1},
        "interruptible": {"type": "boolean"},
        "priority": {"type": "integer"},
        "transition_in_ms": {"type": "integer", "minimum": 0},
        "transition_out_ms": {"type": "integer", "minimum": 0},
        "overlays": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "variants": {"type": "object"}
      }
    }
  }
}